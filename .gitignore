*.onnx
*.safetensors
*.bin

# Local User Test/Chat Sessions, Raw Uploads, Ephemeral Builds, & Agents State
storage/incoming/*
!storage/incoming/.gitkeep
storage/builds/*
!storage/builds/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep
storage/chat_sessions/
storage/agents/
