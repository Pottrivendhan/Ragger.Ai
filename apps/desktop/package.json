{
  "name": "@ragger/desktop",
  "version": "0.1.0",
  "description": "Electron host and process supervisor for Ragger.ai",
  "author": "Ragger.ai",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ragger.ai",
    "productName": "Ragger.ai",
    "electronVersion": "32.3.3",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../engine/dist/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RaggerAI-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ragger.ai"
    }
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4"
  }
}
